# ===========================================================================
# Multilingual file for the TOS 7 Docker application "ntfydocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language；
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"； run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "ntfy"
auth         = "binwiederhier"
version      = "@@VERSION@@"
descript     = "ntfy is a self-hosted push-notification service: publish a message to a topic with a single PUT/POST from any script, monitoring tool or the web UI, then read it in the web UI, the API, WebSocket/SSE or the ntfy phone app. Messages, users and configuration stay in the application data folder, and the server contacts no third-party service unless you enable one of the opt-in integrations. File attachments are disabled until you set base-url and attachment-cache-dir in server.yml."
release_note = "2.38.2-1: rectified per review comments. D18/F2/F7 - removed the redundant attachment-cache-dir setting that made the container exit at startup, so the service now runs and the web UI opens. C3 - complete privacy policy linked from Help. C8 - third-party API table (Docker Hub, optional upstream iOS relay, FCM, web push, SMTP, Twilio). C9 - descriptions match the delivered features, attachments documented as opt-in. L01/L03 - 23-language file regenerated without ASCII semicolons and with LF endings. S11/V1 - non-root uid 1000, capabilities dropped, no-new-privileges, umask 077 and databases 0600. T1 - upstream 2.38.2 security release."
important    = "Requires DockerEngine. Open http://<NAS-IP>:8034/ - the web UI and the API share the port. Runs as uid 1000, capabilities dropped. No authentication by default: anyone who can reach it can publish and subscribe to any topic, so keep it on the LAN or add a user with docker exec -it ntfydocker ntfy user add --role=admin <name> and set NTFY_AUTH_DEFAULT_ACCESS=deny-all. Cache, users and config live in DockerAppData/ntfydocker. Plain HTTP - use a TLS reverse proxy off-LAN. Privacy policy: see the Help link."

[zh-cn]
name         = "ntfy"
auth         = "binwiederhier"
version      = "@@VERSION@@"
descript     = "ntfy 是一个自建的推送通知服务：任何脚本、监控工具或网页只要发一个 PUT/POST 到某个 topic，就能在网页、API、WebSocket/SSE 或 ntfy 手机 App 里收到消息。消息、用户与配置都保存在应用数据目录，除非你主动启用可选出站集成，服务端不连接任何第三方服务。附件功能默认关闭，需在 server.yml 里同时设置 base-url 与 attachment-cache-dir 才能启用。"
release_note = "2.38.2-1: rectified per review comments. D18/F2/F7 - removed the redundant attachment-cache-dir setting that made the container exit at startup, so the service now runs and the web UI opens. C3 - complete privacy policy linked from Help. C8 - third-party API table (Docker Hub, optional upstream iOS relay, FCM, web push, SMTP, Twilio). C9 - descriptions match the delivered features, attachments documented as opt-in. L01/L03 - 23-language file regenerated without ASCII semicolons and with LF endings. S11/V1 - non-root uid 1000, capabilities dropped, no-new-privileges, umask 077 and databases 0600. T1 - upstream 2.38.2 security release."
important    = "需要 DockerEngine。打开 http://<NAS-IP>:8034/，网页与 API 共用该端口。容器以 uid 1000 运行并丢弃全部 capability。默认没有鉴权：任何能访问该端口的人都能向任意 topic 发布或订阅，请只在内网使用，或先用 docker exec -it ntfydocker ntfy user add --role=admin <用户名> 建用户，并把 NTFY_AUTH_DEFAULT_ACCESS 设为 deny-all。缓存、用户与配置都在 DockerAppData/ntfydocker。界面为纯 HTTP，暴露公网前请加带 TLS 的反向代理。隐私政策见帮助链接。"

[zh-hk]
name         = "ntfy"
auth         = "binwiederhier"
version      = "@@VERSION@@"
descript     = "ntfy 是一個自建的推送通知服務：任何腳本、監控工具或網頁只要發一個 PUT/POST 到某個 topic，就能在網頁、API、WebSocket/SSE 或 ntfy 手機 App 裡收到訊息。訊息、使用者與設定都保存在應用資料目錄，除非你主動啟用可選出站整合，伺服器不連接任何第三方服務。附件功能預設關閉，需在 server.yml 裡同時設定 base-url 與 attachment-cache-dir 才能啟用。"
release_note = "2.38.2-1: rectified per review comments. D18/F2/F7 - removed the redundant attachment-cache-dir setting that made the container exit at startup, so the service now runs and the web UI opens. C3 - complete privacy policy linked from Help. C8 - third-party API table (Docker Hub, optional upstream iOS relay, FCM, web push, SMTP, Twilio). C9 - descriptions match the delivered features, attachments documented as opt-in. L01/L03 - 23-language file regenerated without ASCII semicolons and with LF endings. S11/V1 - non-root uid 1000, capabilities dropped, no-new-privileges, umask 077 and databases 0600. T1 - upstream 2.38.2 security release."
important    = "需要 DockerEngine。開啟 http://<NAS-IP>:8034/，網頁與 API 共用該埠。容器以 uid 1000 執行並丟棄全部 capability。預設沒有驗證：任何能存取該埠的人都能向任意 topic 發佈或訂閱，請只在內網使用，或先用 docker exec -it ntfydocker ntfy user add --role=admin <使用者名稱> 建立使用者，並把 NTFY_AUTH_DEFAULT_ACCESS 設為 deny-all。快取、使用者與設定都在 DockerAppData/ntfydocker。介面為純 HTTP，暴露公網前請加帶 TLS 的反向代理。隱私政策見說明連結。"

