# ===========================================================================
# Multilingual file for the TOS 7 Docker application "ntfydocker".
# File name MUST be: <appid>.lang.  23-language superset (14 required by TOS).
# The App Center picks the text matching the user's device language;
# untranslated nodes fall back to English, which the official guide allows.
# Fields: name (app title), auth (upstream author), descript (up to 512
# chars), release_note, important (up to 512 chars).
# Translations come from tosapp.json "translations"; run
#   tosdocker lang <app>          to re-render this file
#   tosdocker translate <app>     to see what still needs translating
# ===========================================================================
[en-us]
name         = "ntfy"
auth         = "binwiederhier"
version      = "@@VERSION@@"
descript     = "ntfy is a self-hosted push-notification service: publish a message to a topic with a single PUT/POST from any script, monitoring tool or the web UI, and read it in the web UI, the API, WebSocket/SSE or the ntfy phone app. The server keeps messages, attachments, its user database and its configuration in the application data folder, and by default contacts no external service - iOS push and e-mail publishing are opt-in settings that need an upstream server or an SMTP account."
release_note = "Review remediation: PRIVACY.md, NOTICE.md and the README privacy / third-party sections added; the help field opens the privacy policy; cache, attachments, the auth database and web-push subscriptions are now pinned inside the mounted data folders so they survive a reinstall; the descriptions were rewritten to match the real feature set; upstream upgraded to 2.38.1."
important    = "Requires DockerEngine. The container listens on 8080 as a non-root user; web UI and API share the port. There is NO authentication by default: anyone who can reach it can publish and subscribe to any topic - keep it on your LAN, or add a user with docker exec -it ntfydocker ntfy user add --role=admin <name> and set NTFY_AUTH_DEFAULT_ACCESS=deny-all. Cache, attachments, users and config live in DockerAppData/ntfydocker. Plain HTTP; use a TLS reverse proxy before exposing it to the internet."

[zh-cn]
name         = "ntfy"
auth         = "binwiederhier"
version      = "@@VERSION@@"
descript     = "ntfy 是一个自建的推送通知服务：任何脚本、监控工具或网页只要发一个 PUT/POST 到某个 topic，就能在网页、API、WebSocket/SSE 或 ntfy 手机 App 里收到消息。服务端把消息、附件、用户库与配置都保存在应用数据目录，默认不连接任何外部服务——iOS 推送与邮件发布是可选项，需要自行配置上游服务器或 SMTP 账号。适合做备份结果、下载完成与监控告警。"
release_note = "Review remediation: PRIVACY.md, NOTICE.md and the README privacy / third-party sections added; the help field opens the privacy policy; cache, attachments, the auth database and web-push subscriptions are now pinned inside the mounted data folders so they survive a reinstall; the descriptions were rewritten to match the real feature set; upstream upgraded to 2.38.1."
important    = "需要 DockerEngine。容器以非 root 用户监听 8080，网页与 API 共用该端口。默认没有鉴权：任何能访问该端口的人都能向任意 topic 发布/订阅——请只在内网使用，或先用 docker exec -it ntfydocker ntfy user add --role=admin <用户名> 建用户，并把 NTFY_AUTH_DEFAULT_ACCESS 设为 deny-all。缓存、附件、用户库与配置都在 DockerAppData/ntfydocker。界面为纯 HTTP，暴露公网前请加带 TLS 的反向代理。"

[zh-hk]
name         = "ntfy"
auth         = "binwiederhier"
version      = "@@VERSION@@"
descript     = "ntfy 是一個自建的推送通知服務：任何腳本、監控工具或網頁只要發一個 PUT/POST 到某個 topic，就能在網頁、API、WebSocket/SSE 或 ntfy 手機 App 裡收到訊息。伺服器把訊息、附件、使用者庫與設定都保存在應用資料目錄，預設不連接任何外部服務——iOS 推送與郵件發佈是可選項，需要自行設定上游伺服器或 SMTP 帳號。適合做備份結果、下載完成與監控告警。"
release_note = "Review remediation: PRIVACY.md, NOTICE.md and the README privacy / third-party sections added; the help field opens the privacy policy; cache, attachments, the auth database and web-push subscriptions are now pinned inside the mounted data folders so they survive a reinstall; the descriptions were rewritten to match the real feature set; upstream upgraded to 2.38.1."
important    = "需要 DockerEngine。容器以非 root 使用者監聽 8080，網頁與 API 共用該埠。預設沒有驗證：任何能存取該埠的人都能向任意 topic 發佈/訂閱——請只在內網使用，或先用 docker exec -it ntfydocker ntfy user add --role=admin <使用者名稱> 建立使用者，並把 NTFY_AUTH_DEFAULT_ACCESS 設為 deny-all。快取、附件、使用者庫與設定都在 DockerAppData/ntfydocker。介面為純 HTTP，暴露公網前請加帶 TLS 的反向代理。"

